<!--
     These system_* colors are also generated by Monet (SystemUI ThemeOverlayController),
     whose fabricated overlays always win over static overlays. ThemeOverlayController reads
     this package and feeds every color defined here into those fabricated overlays as well.
     Use literal values only (no @color references).
-->
<resources>
    <!-- Background -->
    <color name="system_background_light">#FFFFFF</color>
    <color name="system_background_dark">#000000</color>
    <color name="system_surface_light">#FFFFFF</color>
    <color name="system_surface_dark">#000000</color>
    <color name="system_surface_container_lowest_light">#FFFFFF</color>
    <color name="system_surface_container_lowest_dark">#000000</color>
    <color name="system_surface_container_low_light">#FFFFFF</color>
    <color name="system_surface_container_low_dark">#000000</color>
    <!-- DeviceDefault colorBackground (activities and dialogs) -->
    <color name="system_surface_container_light">#FFFFFF</color>
    <color name="system_surface_container_dark">#000000</color>
    <!-- background_device_default / colorBackgroundFloating, Settings (expressive) -->
    <color name="system_neutral1_50_light">#FFFFFF</color>
    <color name="system_neutral1_900_dark">#000000</color>

    <!-- Dialogs (SettingsLib, Material 3) -->
    <color name="system_surface_container_high_light">#FFFFFF</color>
    <color name="system_surface_container_high_dark">#000000</color>

    <!-- Preference items (SettingsLib expressive) -->
    <color name="system_surface_bright_light">#F4F3F1</color>
    <color name="system_surface_bright_dark">#1B202A</color>

    <!-- Shade (dark): notifications background panel and inactive Quick Settings tiles,
         neutral instead of the accent-tinted Monet colors. Notifications themselves use
         an opaque color in SystemUI (witaqua_notification_surface). -->
    <color name="system_surface_effect_0_dark">#99101318</color>
    <color name="system_surface_effect_1_dark">#8A000000</color>
</resources>
